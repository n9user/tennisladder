# MongoDB Configuration
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/tennisladder?retryWrites=true&w=majority

# Resend Email Service
RESEND_API_KEY=re_your_api_key_here

# JWT Secret (generate a random string for production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Configuration
SENDER_EMAIL=noreply@yourdomain.com

# Amsterdam Timezone (do not change)
TZ=Europe/Amsterdam

# Season Configuration
SEASON_NAME=Summer League
SEASON_WEEKS=12
CURRENT_WEEK_OF_SEASON=1
